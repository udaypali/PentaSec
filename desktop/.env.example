# ===========================================
# PentaSec Desktop Application - Environment Variables
# ===========================================

# Copy this file to .env and fill in your actual values
# The .env file should be placed in the desktop/ directory for development
# For production builds, it will be bundled from backend/.env

# -------------------------------------------
# Backend API Configuration
# -------------------------------------------
# Backend server port (default: 5000)
BACKEND_PORT=5000

# Backend host (default: 127.0.0.1)
BACKEND_HOST=127.0.0.1

# -------------------------------------------
# Authentication & Security
# -------------------------------------------
# Secret key for JWT token generation and encryption
# Generate with: openssl rand -base64 32
SECRET_KEY=your-secret-key-here-minimum-32-characters-long

# -------------------------------------------
# Database Configuration
# -------------------------------------------
# MongoDB connection URI (optional - for cloud sync features)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/pentasec

# -------------------------------------------
# Google OAuth Configuration
# -------------------------------------------
# Google OAuth Client ID from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Redirect URI (should match the one configured in Google Cloud Console)
# Default for desktop: http://127.0.0.1:5000/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback/google

# -------------------------------------------
# AI/ML Services
# -------------------------------------------
# Gemini API Key for AI-powered features (redaction, analysis)
# Get your API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------
# OCR Configuration (Optional)
# -------------------------------------------
# Path to Tesseract OCR executable (auto-detected if not set)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS example: /opt/homebrew/bin/tesseract
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=

# -------------------------------------------
# Application Configuration
# -------------------------------------------
# Environment mode (development | production)
NODE_ENV=development

# Enable debug logging (true | false)
DEBUG=false

# Minimum app version required to use the application.
# Clients running a version below this will see the "Update Required" screen.
# Update this value on Render (Environment tab) to gate older clients without redeploying code.
REQUIRED_VERSION=

# Comma-separated list of allowed CORS origins.
# In production on Render, set this to your actual frontend URL(s).
# Example: https://your-app.onrender.com,https://pentasec.app
# Defaults to localhost in development if not set.
ALLOWED_ORIGINS=

# -------------------------------------------
# Data Storage Paths (Auto-configured, rarely need to change)
# -------------------------------------------
# Directory for storing application data
# Windows: %APPDATA%/PentasecDesktop
# macOS: ~/Library/Application Support/PentasecDesktop
# Linux: ~/.config/PentasecDesktop
# DATA_DIR=

# Directory for storing evidence files
# EVIDENCE_DIR=

# -------------------------------------------
# Security & Privacy Settings (Optional)
# -------------------------------------------
# Enable/disable automatic error reporting
ENABLE_ERROR_REPORTING=false

# Session timeout in minutes (default: 30)
SESSION_TIMEOUT=30
